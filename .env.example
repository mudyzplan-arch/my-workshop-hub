# ---------- DATABASE ----------
# PostgreSQL connection string (user, password, host, port, database name)
DATABASE_URL="postgresql://postgres:password@localhost:5432/workshop_hub"

# ---------- AUTH ----------
# Any long random text. Generate one with:  openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-string"

# ---------- M-PESA (Safaricom Daraja) ----------
# true  = fake STK push (no keys needed, great for demo)
# false = real Daraja calls (fill in everything below)
MPESA_SIMULATE="true"
MPESA_ENV="sandbox"                 # "sandbox" or "production"
MPESA_CONSUMER_KEY=""               # TODO: from developer.safaricom.co.ke > My Apps
MPESA_CONSUMER_SECRET=""            # TODO: from the same app
MPESA_SHORTCODE="174379"            # TODO: sandbox default is 174379; use your Paybill/Till in production
MPESA_PASSKEY=""                    # TODO: Lipa Na M-Pesa Online passkey (Daraja > APIs > M-Pesa Express)
MPESA_CALLBACK_URL=""               # TODO: PUBLIC https URL, e.g. https://abc.ngrok.app/api/payments/mpesa/callback

# ---------- CARD PAYMENTS ----------
# "simulate" (demo) | "stripe" | "pesapal"
CARD_PROVIDER="simulate"
STRIPE_SECRET_KEY=""                # TODO: dashboard.stripe.com > Developers > API keys
PESAPAL_CONSUMER_KEY=""             # TODO: from Pesapal merchant dashboard
PESAPAL_CONSUMER_SECRET=""          # TODO
PESAPAL_IPN_ID=""                   # TODO: registered IPN id
